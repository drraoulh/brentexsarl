# Variables d'environnement — BRENTEX SARL
# Copier ce fichier en .env.local et remplir les valeurs

# URL publique du site (pour SEO, sitemap)
NEXT_PUBLIC_SITE_URL=https://brentexsarl.com

# Mot de passe du back-office CMS (/admin)
ADMIN_PASSWORD=changez-ce-mot-de-passe

# Email de réception des formulaires (optionnel)
CONTACT_EMAIL=brentexsarl2017@gmail.com

